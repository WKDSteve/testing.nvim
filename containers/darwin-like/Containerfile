# The image of `testing ci --on=darwin-like` (testing.ci.on): the error classes that otherwise only the hosted macOS run
# shows, caught on this machine. It is NOT macOS and a green run here proves nothing about macOS; it only fails where
# macOS would fail for one of these reasons:
#
#   * bash 3.2 (the /bin/bash and /bin/sh of macOS): no `declare -A`, no `${x,,}`, no `mapfile`, `set -u` on an empty
#     array is an error. Built from the GNU sources in a Debian stage (static, so the musl userland below runs it) and
#     installed as /bin/bash AND /bin/sh.
#   * the BSD userland (Chimera Linux has FreeBSD's): `sed -i` needs a suffix argument, `stat -f` not `stat -c`, no
#     `grep -P`, `du`/`date`/`readlink` with the BSD flags. The build checks a few of them.
#   * TMPDIR behind a symbolic link: on macOS `$TMPDIR` is /var/folders/.../T/ and /var is a link to /private/var, so a
#     path that went through realpath no longer starts with the TMPDIR a test compared it to.
#   * no Docker, no git extras (git itself only).
#
# Not reproduced: the ARM64 memory model, FSEvents, the GUI, the timing of the hosted runners. A case-insensitive
# working tree is what the mount of a Windows checkout already gives (Podman on WSL, drvfs); on a Linux host it would
# need a casefold file system, which this image does not set up (docs/CI.md).
#
# Built once, with the network:
#
#   podman build --tag localhost/testing-darwin-like:1 containers/darwin-like
#
# What comes from the network is fixed here: the base images by digest, the bash sources by their sha256 (checked on
# 2026-11-12 against the GPG signature of ftp.gnu.org, key of Chet Ramey 7C0135FB088AAF6C66C650B9BB5869F064EA74AB);
# a tarball with another sum fails the build. Moving a pin is a new tag (`:2`, and `testing.ci.on.DARWIN_IMAGE`): a
# proof names the image id it ran in.
#
# First built 2026-11-12 (Chimera 2026-11, neovim 0.12.6, git 2.56.1).

FROM docker.io/library/debian:bookworm-slim@sha256:c67e92c8099ba22853ab4cfda7cfb494d253d6012ca82dee98ba8976772af018 AS bash32
ARG BASH_VERSION=3.2.57
# code from the network is only built when its sum is this one
ARG BASH_SHA256=3fa9daf85ebf35068f090ce51283ddeeb3c75eb5bc70b1a4a7cb05868bfe06a4
RUN set -eux; \
    test -n "${BASH_SHA256}" || { echo "BASH_SHA256 is required (--build-arg BASH_SHA256=...)"; exit 1; }; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gcc libc6-dev make bison; \
    curl -fsSLo /tmp/bash.tar.gz "https://ftp.gnu.org/gnu/bash/bash-${BASH_VERSION}.tar.gz"; \
    echo "${BASH_SHA256}  /tmp/bash.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/bash.tar.gz -C /tmp; \
    cd "/tmp/bash-${BASH_VERSION}"; \
    CFLAGS="-O2 -std=gnu89 -Wno-implicit-function-declaration -Wno-implicit-int -Wno-int-conversion" \
      ./configure --prefix=/opt/bash32 --enable-static-link --without-bash-malloc; \
    make -j"$(nproc)"; \
    make install; \
    /opt/bash32/bin/bash -c 'echo "$BASH_VERSION"' | grep -q '^3\.2\.'

FROM docker.io/chimeralinux/chimera:latest@sha256:ef2b5165b3a43474a212caf7d3d9d1505bf9f7bc835d776d5ad687e3d12e3902
RUN set -eux; \
    apk add --no-interactive chimera-repo-user; \
    apk update; \
    apk add --no-interactive neovim git; \
    nvim --version | head -1; git --version
COPY --from=bash32 /opt/bash32/bin/bash /usr/local/bin/bash32
# /bin/sh and /bin/bash are bash 3.2 from here on (the last step: apk's own scripts ran with the system shell)
RUN ["/usr/local/bin/bash32", "-c", "set -e; ln -sf /usr/local/bin/bash32 /bin/bash; ln -sf /usr/local/bin/bash32 /bin/sh; ln -sf /usr/local/bin/bash32 /usr/bin/bash; ln -sf /usr/local/bin/bash32 /usr/bin/sh"]
# the BSD flags are there (a GNU tool would refuse each of these), and bash 3.2 answers as bash and as sh
RUN set -e; \
    test "$(sh -c 'echo ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}')" = 3.2; \
    test "$(bash -c 'echo ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}')" = 3.2; \
    stat -f %z /etc/passwd >/dev/null; \
    printf 'a\n' > /tmp/sed-probe; sed -i '' 's/a/b/' /tmp/sed-probe; test "$(cat /tmp/sed-probe)" = b; \
    rm -f /tmp/sed-probe; \
    if echo x | grep -P x >/dev/null 2>&1; then echo "grep -P works: not the BSD grep"; exit 1; fi; \
    if command -v docker >/dev/null 2>&1; then echo "docker must not be here"; exit 1; fi
# TMPDIR as on macOS: /var/folders/... where /var/folders is a link into /private/var
RUN set -e; \
    mkdir -p /private/var/folders/zz/zyxvpxvq6csfxvn_n0000000000000/T; \
    chmod 1777 /private/var/folders/zz/zyxvpxvq6csfxvn_n0000000000000/T; \
    rm -rf /var/folders; ln -s /private/var/folders /var/folders
ENV TMPDIR=/var/folders/zz/zyxvpxvq6csfxvn_n0000000000000/T/ \
    SHELL=/bin/bash
WORKDIR /repo

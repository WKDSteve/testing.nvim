# The image of `testing ci --on=linux` (testing.ci.on): the pipeline of a repository on Linux, with the tools at the
# versions of the hosted CI (testing.ci.workflow.TOOLS: nvim 0.12.2, stylua 2.5.2, luacheck 1.2.0). git is the one of
# the Debian release (bookworm: 2.39). Built once, with the network:
#
#   podman build --tag localhost/testing-ci:1 containers/ci
#
# A change here is a new tag (`:2`, and `testing.ci.on.DEFAULT_IMAGE`): a proof names the image id it ran in.
FROM docker.io/library/debian:bookworm-slim
ARG NVIM=0.12.2
ARG STYLUA=2.5.2
ARG LUACHECK=1.2.0
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git unzip lua5.1 liblua5.1-0-dev luarocks gcc libc6-dev; \
    arch="$(uname -m)"; \
    case "$arch" in x86_64) nv=x86_64; sl=x86_64 ;; aarch64) nv=arm64; sl=aarch64 ;; *) echo "unsupported $arch"; exit 1 ;; esac; \
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v${NVIM}/nvim-linux-${nv}.tar.gz" | tar -xz -C /opt; \
    ln -s "/opt/nvim-linux-${nv}/bin/nvim" /usr/local/bin/nvim; \
    curl -fsSLo /tmp/stylua.zip "https://github.com/JohnnyMorganz/StyLua/releases/download/v${STYLUA}/stylua-linux-${sl}.zip"; \
    unzip -o /tmp/stylua.zip -d /usr/local/bin; \
    chmod +x /usr/local/bin/stylua; \
    rm /tmp/stylua.zip; \
    luarocks install luacheck "${LUACHECK}"; \
    apt-get purge -y gcc; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*; \
    nvim --version | head -1; stylua --version; luacheck --version; git --version
WORKDIR /repo

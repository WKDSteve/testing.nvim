# Linux environment for container checks (testing.container): a real Linux with Neovim, the trash tools
# and xdg-utils, and fonts pinned by the Alpine release (3.22 fixes every package version range).
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache neovim git glib fontconfig trash-cli xdg-utils font-dejavu tmux \
    && adduser -D tester
USER tester
ENV HOME=/home/tester XDG_DATA_HOME=/home/tester/.local/share
WORKDIR /home/tester

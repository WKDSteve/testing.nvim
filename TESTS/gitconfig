# The git configuration of this suite (TESTS/minimal_init.lua points GIT_CONFIG_GLOBAL here and sets
# GIT_CONFIG_NOSYSTEM): the fixture repositories the specs make see this file, not the machine's global and system
# configuration. A global `core.hooksPath` there runs a shell per hook on every `git commit` and `git worktree add`
# of a fixture (four on a commit; about 0.4 s each on Windows), signing settings start ssh-keygen, and `core.autocrlf`
# differs from machine to machine. A spec that needs a setting passes it with `-c` or `git config` in its repository.
[core]
	autocrlf = false
	fscache = true
[init]
	defaultBranch = master
[user]
	name = testing.nvim spec
	email = spec@example.invalid
[commit]
	gpgsign = false
[tag]
	gpgsign = false
